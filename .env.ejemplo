# Valores de la demo local. En AWS: sin INGESTA_AWS_ENDPOINT ni llaves (rol IAM).
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
INGESTA_AWS_ENDPOINT=http://localhost:54566
INGESTA_BUCKET=facturas
INGESTA_Q_INGESTA=http://localhost:54566/000000000000/q-ingesta
INGESTA_Q_GPU=http://localhost:54566/000000000000/q-gpu
INGESTA_Q_VALIDACION=http://localhost:54566/000000000000/q-validacion
INGESTA_Q_INGESTA_DLQ=http://localhost:54566/000000000000/q-ingesta-dlq
INGESTA_Q_GPU_DLQ=http://localhost:54566/000000000000/q-gpu-dlq
INGESTA_DSN=postgresql://ingesta_escritura:demo@localhost:55432/facturas
# ollama (local) | vllm (AWS). Con vllm, INGESTA_MODELO e INGESTA_OCR son obligatorias.
INGESTA_BACKEND=ollama
INGESTA_MODELO=qwen3.5:2b
INGESTA_OCR=glm-ocr:latest
